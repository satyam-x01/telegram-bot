# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Bot Owner Username (without @ or with @)
OWNER_USERNAME=@s2u_007

# Optional: Default Bot Language (en, hi, hinglish)
DEFAULT_LANGUAGE=en

# Optional: stable HTTPS host for direct downloads. Leave empty to use a temporary
# Cloudflare Quick Tunnel (requires cloudflared installed; the URL changes on restart).
# PUBLIC_BASE_URL=
# PUBLIC_DOWNLOAD_PORT=8765

# Optional: Cloudflare Pages URL for the licensed-audio web player.
# PLAYER_BASE_URL=https://your-project.pages.dev

# Optional: Telegram MTProto Credentials for Cloud Storage (from my.telegram.org)
# TELEGRAM_API_ID=2040
# TELEGRAM_API_HASH=b18441a1ac60e7031d112efc4646b16e
